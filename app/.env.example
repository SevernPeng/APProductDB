# Reference only: run scripts/create_env.py to generate local paths and a random key.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=America/Mexico_City
# Example paths below are for the optional Windows scheduled-task layout only.
# For LAN access, use your server's real IPv4 and prefix (docs/DEPLOYMENT.md).
AP_PRODUCT_DATA_ROOT=D:\APProductDB
AP_PRODUCT_REQUIRE_D_DRIVE=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DATABASE_PATH=D:\APProductDB\data\ap_products.sqlite3
MEDIA_ROOT=D:\APProductDB\media
STATIC_ROOT=D:\APProductDB\staticfiles
LOG_DIR=D:\APProductDB\logs
BACKUP_DIR=D:\APProductDB\backups
