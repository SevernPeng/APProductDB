DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.100
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.1.100:8000
DJANGO_TIME_ZONE=America/Mexico_City
AP_PRODUCT_DATA_ROOT=D:\APProductDB
AP_PRODUCT_REQUIRE_D_DRIVE=True
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
AI_DATASHEET_ENABLED=False
AI_DATASHEET_BASE_URL=http://127.0.0.1:11434/
AI_DATASHEET_MODEL=qwen3-vl:4b
AI_DATASHEET_TEXT_MODEL=qwen3:1.7b
AI_DATASHEET_VISION_MODEL=qwen3-vl:2b-instruct
AI_DATASHEET_TEXT_PAGE_LIMIT=5
AI_DATASHEET_EVIDENCE_PAGE_LIMIT=12
AI_DATASHEET_HEAD_PAGES=2
AI_DATASHEET_VISION_PAGE_LIMIT=4
AI_DATASHEET_TIMEOUT=1800
AI_DATASHEET_MIN_CONFIDENCE=0.72
AI_DATASHEET_CONTEXT_LENGTH=16384
AI_DATASHEET_KEEP_ALIVE=5m
AI_DATASHEET_OCR_THRESHOLD=500
AI_DATASHEET_MAX_TEXT_CHARS=40000
AI_DATASHEET_MAX_VISION_PAGES=40
AI_DATASHEET_RENDER_DPI=96
AI_DATASHEET_MAX_OUTPUT_TOKENS=3072
AI_DATASHEET_RULE_SKIP_RATIO=0.85
AI_DATASHEET_WORKERS=1
DATABASE_PATH=D:\APProductDB\data\ap_products.sqlite3
MEDIA_ROOT=D:\APProductDB\media
STATIC_ROOT=D:\APProductDB\staticfiles
LOG_DIR=D:\APProductDB\logs
BACKUP_DIR=D:\APProductDB\backups
